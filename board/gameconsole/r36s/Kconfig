if TARGET_R36S

config SYS_BOARD
	default "r36s"

config SYS_VENDOR
	default "gameconsole"

config SYS_CONFIG_NAME
	default "r36s"

config BOARD_SPECIFIC_OPTIONS # dummy
	def_bool y
	select ADC
	select BOARD_LATE_INIT

config R36S_SERIAL
	string "Serial number (serial#) to report"
	default "c3d9b8674f4b94f6"
	help
	  The vendor U-Boot reports the same serial number on every console
	  (an unseeded rand()), and the adb serial, the USB gadget serial and
	  the R36 Ultra Wi-Fi MAC address follow it. Keep it to stay
	  compatible. Leave empty to use the serial number made from the
	  CPU id instead (different on every console).

endif
